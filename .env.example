SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

PUBLIC_APP_URL=https://crm.example.com
VITE_PUBLIC_APP_URL=https://crm.example.com

# Chave exclusiva para criptografar tokens Meta (mínimo de 32 caracteres).
# Não reutilize SUPABASE_SECRET_KEY e mantenha o mesmo valor em todas as instâncias.
META_TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret
META_API_VERSION=v23.0

CRON_SECRET=replace-with-long-random-secret
SHORT_BRASIL_WEBHOOK_SECRET=replace-with-long-random-secret

EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-with-provider-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-separate-webhook-secret

# API HTTPS atual (preferida). O token é enviado somente no servidor.
SHORTCODE_SMS_TOKEN=replace-with-shortcode-bearer-token
SHORTCODE_SMS_URL=https://api.shortcode.com.br/messages
# Compatibilidade com a API legada; usada apenas quando SHORTCODE_SMS_TOKEN não existe.
SHORT_BRASIL_SMS_USUARIO=replace-with-legacy-short-brasil-usuario
SHORT_BRASIL_SMS_CHAVE=replace-with-legacy-short-brasil-chave
# Short.io is disabled by default. Keep this secret server-side; never prefix it
# with VITE_. Domain may be overridden per tenant in shortio_settings.
SHORTIO_ENABLED=false
SHORTIO_API_KEY=replace-with-shortio-secret-api-key
SHORTIO_DOMAIN=go.example.com
# Email e voz usam exclusivamente Infobip.
EMAIL_PROVIDER=infobip
INFOBIP_BASE_URL=https://your-account.api.infobip.com
INFOBIP_API_KEY=replace-with-scoped-api-key
INFOBIP_WEBHOOK_SECRET=replace-with-webhook-signing-secret
VOICE_PROVIDER=infobip
INFOBIP_VOICE_FROM=5511980465329
INFOBIP_VOICE_CALLBACK_TOKEN=replace-with-long-random-secret
# Keep automatic voice dispatch disabled until formal operational acceptance.
# Callback reconciliation is safe and independent from this switch.
VOICE_DISPATCH_ENABLED=false

# Kill switch do worker de jornadas. A publicacao de uma jornada nao habilita
# este processo. Em producao, altere para true somente apos o checklist de
# ativacao e recrie o container para que a variavel seja recarregada.
JOURNEYS_DISPATCH_ENABLED=false
# Scanner separado: descobre elegiveis e cria inscricoes; nao chama provedores.
JOURNEYS_SCANNER_ENABLED=false
# Canario conservador; capacidade maxima atual: 10 jobs e 2.000 players/job.
JOURNEYS_SCANNER_JOB_LIMIT=3
JOURNEYS_SCANNER_BATCH_SIZE=500
# Dispatcher de jornadas (ENV-01). Valores fora da faixa sao limitados.
# Maximo de itens reivindicados por execucao (1..1000).
JOURNEYS_DISPATCH_BATCH_SIZE=250
# Itens em processamento simultaneo por execucao (padrao 12, teto 40). A vazao
# real ao provedor e limitada pela tabela channel_rate_limits (sem deploy).
JOURNEYS_DISPATCH_CONCURRENCY=12
# Reivindica itens novos apenas nos primeiros N segundos (5..50; abaixo dos 55 s
# do pg_net); itens em andamento terminam, os nao iniciados sao devolvidos.
JOURNEYS_DISPATCH_TIME_BUDGET_SECONDS=45
# Teto para aguardar itens em andamento antes de encerrar a execucao.
JOURNEYS_DISPATCH_HARD_DEADLINE_SECONDS=240
# Lease por item e por slot do worker (30..900), renovado a cada 1/4.
JOURNEYS_DISPATCH_LEASE_SECONDS=120
# Execucoes simultaneas permitidas (1..8); ticks excedentes saem com "busy".
JOURNEYS_DISPATCH_MAX_WORKERS=1
# O worker exige ao menos uma allowlist, salvo liberacao global explicita.
JOURNEYS_CANARY_TENANT_IDS=
JOURNEYS_CANARY_JOURNEY_IDS=
JOURNEYS_ALLOW_ALL_TENANTS=false
# Polling Short.io: 200 links/tick com 15 requisicoes simultaneas por padrao.
SHORTIO_SYNC_BATCH_SIZE=200
SHORTIO_SYNC_CONCURRENCY=15
# HMAC dos redirects first-party. Em transicao, CRON_SECRET e aceito como
# fallback; producao deve usar um segredo dedicado com pelo menos 32 caracteres.
CLICK_TRACKING_SECRET=

LOVABLE_API_KEY=replace-if-ai-enabled
OPENAI_API_KEY=replace-if-edge-ai-enabled

ELEVENLABS_API_KEY=replace-if-voice-generation-enabled
ELEVENLABS_DEFAULT_VOICE_ID=replace-if-needed
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Sentry (observabilidade de erros) ---
# Todas opcionais: com SENTRY_DSN / VITE_SENTRY_DSN vazios o Sentry fica desligado.
# Nunca commite DSN, token ou qualquer valor real neste arquivo.
# DSN do projeto Node (servidor). Lido por instrument.mjs no start.
SENTRY_DSN=https://0c1a314fa6f49a2062e9ecb6ca72eed6@o4512257597374464.ingest.us.sentry.io/4512257611268096
# Ambiente exibido no Sentry (ex.: production, homologacao). Padrao: NODE_ENV.
SENTRY_ENVIRONMENT=production
# Release = SHA do commit em deploy (ex.: SENTRY_RELEASE=$(git rev-parse --short HEAD)).
SENTRY_RELEASE=
# Fracao de transacoes rastreadas no servidor (0 a 1). Padrao: 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# DSN do projeto React (navegador). E publico por natureza, mas fica fora do git.
# Precisa existir no momento do build (vai embutido no bundle do front-end).
VITE_SENTRY_DSN=htps://a87ebb3893f6f72b6d382878b8604d7a@o4512257597374464.ingest.us.sentry.io/4512257807155200
# Fracao de navegacoes rastreadas no navegador (0 a 1). Padrao: 0.1.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Upload de source maps no build. So ativo quando os tres estiverem preenchidos;
# sem eles o build fica identico ao atual. O token e segredo: use apenas no
# ambiente de build (ex.: docker build --secret id=sentry_auth_token,env=SENTRY_AUTH_TOKEN).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Better Stack (heartbeats dos jobs) ---
# URL do heartbeat criado no Better Stack para cada job. O job faz ping ao
# concluir com sucesso e <url>/fail em falha. Vazio = sem ping.
# Ver docs/RUNBOOK_OBSERVABILIDADE.md para o período esperado de cada um.
BETTERSTACK_HEARTBEAT_JOURNEY_DISPATCH=
BETTERSTACK_HEARTBEAT_JOURNEY_SCAN=
BETTERSTACK_HEARTBEAT_SMS_CAMPAIGN_DISPATCH=
BETTERSTACK_HEARTBEAT_SMS_TICK=
BETTERSTACK_HEARTBEAT_EMAIL_TICK=
BETTERSTACK_HEARTBEAT_EMAIL_CAMPAIGN=
BETTERSTACK_HEARTBEAT_WEBHOOK_REPLAY=
BETTERSTACK_HEARTBEAT_SHORTIO_SYNC=
BETTERSTACK_HEARTBEAT_RECOVERY=

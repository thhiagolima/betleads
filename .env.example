SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

PUBLIC_APP_URL=https://crm.example.com
VITE_PUBLIC_APP_URL=https://crm.example.com

# Chave exclusiva para criptografar tokens Meta (mínimo de 32 caracteres).
# Não reutilize SUPABASE_SECRET_KEY e mantenha o mesmo valor em todas as instâncias.
META_TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret
META_API_VERSION=v23.0

CRON_SECRET=replace-with-long-random-secret
SHORT_BRASIL_WEBHOOK_SECRET=replace-with-long-random-secret

EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-with-provider-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-separate-webhook-secret

# API HTTPS atual (preferida). O token é enviado somente no servidor.
SHORTCODE_SMS_TOKEN=replace-with-shortcode-bearer-token
SHORTCODE_SMS_URL=https://api.shortcode.com.br/messages
# Compatibilidade com a API legada; usada apenas quando SHORTCODE_SMS_TOKEN não existe.
SHORT_BRASIL_SMS_USUARIO=replace-with-legacy-short-brasil-usuario
SHORT_BRASIL_SMS_CHAVE=replace-with-legacy-short-brasil-chave
# Short.io is disabled by default. Keep this secret server-side; never prefix it
# with VITE_. Domain may be overridden per tenant in shortio_settings.
SHORTIO_ENABLED=false
SHORTIO_API_KEY=replace-with-shortio-secret-api-key
SHORTIO_DOMAIN=go.example.com
# Email e voz usam exclusivamente Infobip.
EMAIL_PROVIDER=infobip
INFOBIP_BASE_URL=https://your-account.api.infobip.com
INFOBIP_API_KEY=replace-with-scoped-api-key
INFOBIP_WEBHOOK_SECRET=replace-with-webhook-signing-secret
VOICE_PROVIDER=infobip
INFOBIP_VOICE_FROM=5511980465329
INFOBIP_VOICE_CALLBACK_TOKEN=replace-with-long-random-secret
# Keep automatic voice dispatch disabled until formal operational acceptance.
# Callback reconciliation is safe and independent from this switch.
VOICE_DISPATCH_ENABLED=false

# Kill switch do worker de jornadas. A publicacao de uma jornada nao habilita
# este processo. Em producao, altere para true somente apos o checklist de
# ativacao e recrie o container para que a variavel seja recarregada.
JOURNEYS_DISPATCH_ENABLED=false
# Scanner separado: descobre elegiveis e cria inscricoes; nao chama provedores.
JOURNEYS_SCANNER_ENABLED=false
# Canario conservador; capacidade maxima atual: 10 jobs e 2.000 players/job.
JOURNEYS_SCANNER_JOB_LIMIT=3
JOURNEYS_SCANNER_BATCH_SIZE=500
# Ajuste ao limite contratado do provedor; a concorrencia e limitada separadamente.
JOURNEYS_DISPATCH_BATCH_SIZE=250
# Numero maximo de chamadas simultaneas ao provedor; separado do lote para
# permitir escoar fila rapidamente sem rajada descontrolada.
JOURNEYS_DISPATCH_CONCURRENCY=40
# O worker exige ao menos uma allowlist, salvo liberacao global explicita.
JOURNEYS_CANARY_TENANT_IDS=
JOURNEYS_CANARY_JOURNEY_IDS=
JOURNEYS_ALLOW_ALL_TENANTS=false
# Polling Short.io: 200 links/tick com 15 requisicoes simultaneas por padrao.
SHORTIO_SYNC_BATCH_SIZE=200
SHORTIO_SYNC_CONCURRENCY=15

LOVABLE_API_KEY=replace-if-ai-enabled
OPENAI_API_KEY=replace-if-edge-ai-enabled

ELEVENLABS_API_KEY=replace-if-voice-generation-enabled
ELEVENLABS_DEFAULT_VOICE_ID=replace-if-needed
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
